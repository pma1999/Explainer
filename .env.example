# ==========================================
# CONFIGURACIÓN DE DESARROLLO LOCAL
# ==========================================

# Base de datos (SQLite para desarrollo)
# DATABASE_URL=sqlite:///./data/explainer.db

# Para producción en Fly.io con PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Seguridad - Genera valores únicos con:
# openssl rand -base64 32
APP_ENCRYPTION_KEY=dev_key_cambiar_en_produccion_32bytes!!
JWT_SECRET=dev_secret_cambiar_en_produccion_32bytes!!

# Entorno
ENVIRONMENT=development
FRONTEND_URL=http://localhost:8000

# Gemini (opcional en dev - cada usuario usa la suya)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-pro-preview-05-06

# Redis (opcional - solo para SSE distribuido en múltiples instancias)
# REDIS_URL=redis://localhost:6379
