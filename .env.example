# ==========================================
# CONFIGURACIÓN DE DESARROLLO LOCAL
# ==========================================

# Seguridad - Genera con: openssl rand -base64 32
APP_ENCRYPTION_KEY=dev_key_cambiar_en_produccion_32bytes!!

# Entorno
ENVIRONMENT=development
FRONTEND_URL=http://localhost:8000

# Supabase (obligatorio para proyectos y auth)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=tu-jwt-secret-from-dashboard

# Gemini (opcional en dev)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-pro-preview-05-06

# OpenRouter / DeepSeek / Tavily son BYOK por usuario desde Ajustes.
# Estas variables no son necesarias para el flujo normal multiusuario, pero pueden
# servir para scripts locales o pruebas manuales.
# OPENROUTER_API_KEY=sk-or-v1-...
# DEEPSEEK_API_KEY=...
# TAVILY_API_KEY=tvly-...
# MISTRAL_API_KEY=...
#
# Caché OCR nativa de Mistral para PDFs: auto | supabase | disk
# - auto (por defecto): Postgres (Supabase) si SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY están definidos; si no, disco local.
# - supabase: tabla pdf_ocr_cache (requiere migración aplicada).
# - disk: solo data/pdf_ocr_cache o PDF_OCR_CACHE_DIR.
# PDF_OCR_CACHE_BACKEND=auto

# Redis (opcional - solo para SSE distribuido en múltiples instancias)
# REDIS_URL=redis://localhost:6379
